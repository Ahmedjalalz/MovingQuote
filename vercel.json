{
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/aldhouseandsmith",
      "destination": "/aldhouseandsmith/index.html"
    },
    {
      "source": "/aldhouseandsmith/(.*)",
      "destination": "/aldhouseandsmith/index.html"
    },
    {
      "source": "/unitywasteremovals",
      "destination": "/unitywasteremovals/index.html"
    },
    {
      "source": "/unitywasteremovals/(.*)",
      "destination": "/unitywasteremovals/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
