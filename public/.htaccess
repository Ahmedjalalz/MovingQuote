<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^officemovinginternational/?$ /officemovinginternational/index.html [L]
  RewriteRule ^officemovinginternational/(.*)$ /officemovinginternational/index.html [L]
  RewriteRule ^movemanltd\.com/?$ /movemanltd.com/index.html [L]
  RewriteRule ^movemanltd\.com/(.*)$ /movemanltd.com/index.html [L]
  RewriteRule ^movemanltd/?$ /movemanltd/index.html [L]
  RewriteRule ^movemanltd/(.*)$ /movemanltd/index.html [L]
  RewriteRule ^radicalcourier/?$ /radicalcourier/index.html [L]
  RewriteRule ^radicalcourier/(.*)$ /radicalcourier/index.html [L]
  RewriteRule ^ravensoakecaravanstorage/?$ /ravensoakecaravanstorage/index.html [L]
  RewriteRule ^ravensoakecaravanstorage/(.*)$ /ravensoakecaravanstorage/index.html [L]
  RewriteRule ^roads2roads/?$ /roads2roads/index.html [L]
  RewriteRule ^frontlinetransport/?$ /frontlinetransport/index.html [L]
  RewriteRule ^aldhouseandsmith/?$ /aldhouseandsmith/index.html [L]
  RewriteRule ^unitywasteremovals/?$ /unitywasteremovals/index.html [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
